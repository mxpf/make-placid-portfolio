{
  "name": "make-placid-portfolio",
  "description": "Make Placid, an elegant content-led portfolio template for creative practices.",
  "version": "2.0.0-alpha.1",
  "license": "MIT",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "images": "node scripts/generate-responsive-images.mjs",
    "build": "npm run images && next build --webpack && node scripts/prune-responsive-source-images.mjs out",
    "verify:export": "node scripts/verify-static-export.mjs",
    "test": "npm run build && npm run verify:export && node --test tests/rendered-html.test.mjs",
    "test:e2e": "playwright test",
    "test:all": "npm test && npm run test:e2e",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "audit:production": "npm audit --omit=dev --audit-level=high",
    "audit:full": "npm audit --audit-level=high"
  },
  "dependencies": {
    "@mxpf/write-placid-core": "https://github.com/mxpf/write-placid/releases/download/v1.6.0/mxpf-write-placid-core-1.6.0.tgz",
    "marked": "^18.0.14",
    "next": "16.3.8",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.17.0",
    "yaml": "^2.9.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.8",
    "sharp": "0.35.5",
    "typescript": "5.9.3"
  },
  "overrides": {
    "minimatch@3.1.5": {
      "brace-expansion": "1.1.21"
    },
    "minimatch@10.2.5": {
      "brace-expansion": "5.0.12"
    },
    "source-map-js": "1.2.2"
  },
  "type": "module"
}
