{
  "name": "make-placid-portfolio",
  "description": "Make Placid, an elegant content-led portfolio template for creative practices.",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev --webpack",
    "images": "node scripts/generate-responsive-images.mjs",
    "build": "npm run images && next build --webpack && node scripts/prune-responsive-source-images.mjs out",
    "test": "npm run build && node --test tests/rendered-html.test.mjs",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "marked": "^18.0.9",
    "next": "16.3.0",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.0",
    "sharp": "^0.35.3",
    "typescript": "5.9.3"
  },
  "type": "module"
}
